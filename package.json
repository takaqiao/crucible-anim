{
  "name": "crucible-anim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crucible 系统动画补齐模组的开发工具与测试",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "index": "node tools/index-sfx.mjs && node tools/extract-db.mjs",
    "sounds": "node tools/gen-sound-table.mjs",
    "clips": "node tools/gen-clip-table.mjs",
